# 本地工作区输出
ruoyi-ui/node_modules/
ruoyi-ui/dist/
ruoyi-backend/**/target/
ruoyi-backend/**/logs/
ruoyi-backend/**/uploadPath/

# 根目录下的前端目录是当前维护的 Vue 3 前端。
ruoyi-backend/ruoyi-ui/

