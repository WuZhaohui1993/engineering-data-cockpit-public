config/ruoyi-local.env
.local/
.tmp-test-assets/

# Raw database backups must remain local; only reviewed sanitized snapshots may be committed
database/backups/**/*_full.sql
database/backups/**/*_raw.sql

# Local OS/editor files
.DS_Store
*.log
