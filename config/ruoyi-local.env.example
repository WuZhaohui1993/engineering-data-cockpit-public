# 复制为 config/ruoyi-local.env，并填写本地 MySQL 密码。
# The copied file is ignored by git because it may contain credentials.

MYSQL_HOST=${MYSQL_HOST:-127.0.0.1}
MYSQL_PORT=${MYSQL_PORT:-3306}
MYSQL_DATABASE=${MYSQL_DATABASE:-engineering_data_cockpit}
MYSQL_USERNAME=${MYSQL_USERNAME:-root}
MYSQL_PASSWORD=${MYSQL_PASSWORD:-}

# 上传文件目录；默认使用当前工作目录下的 uploadPath。
RUOYI_PROFILE=${RUOYI_PROFILE:-./uploadPath}

# 生产和共享环境必须使用固定高强度令牌密钥。本地启动脚本未配置时会生成到 .local/。
TOKEN_SECRET=${TOKEN_SECRET:-}
DRUID_STAT_VIEW_ENABLED=${DRUID_STAT_VIEW_ENABLED:-false}
DRUID_LOGIN_USERNAME=${DRUID_LOGIN_USERNAME:-}
DRUID_LOGIN_PASSWORD=${DRUID_LOGIN_PASSWORD:-}

# 外部业务数据源配置示例。只填写只读账号或密钥引用。
LABOR_MYSQL_HOST=${LABOR_MYSQL_HOST:-127.0.0.1}
LABOR_MYSQL_PORT=${LABOR_MYSQL_PORT:-3306}
LABOR_MYSQL_DATABASE=${LABOR_MYSQL_DATABASE:-labor}
LABOR_MYSQL_USERNAME=${LABOR_MYSQL_USERNAME:-root}
LABOR_MYSQL_PASSWORD=${LABOR_MYSQL_PASSWORD:-}
LABOR_API_BASE_URL=${LABOR_API_BASE_URL:-}
LABOR_API_TOKEN=${LABOR_API_TOKEN:-}
LABOR_PROJECT_CODE=${LABOR_PROJECT_CODE:-}
DASHBOARD_API_ALLOWED_HOSTS=${DASHBOARD_API_ALLOWED_HOSTS:-127.0.0.1,localhost}
DASHBOARD_WEBSOCKET_ALLOWED_ORIGIN=${DASHBOARD_WEBSOCKET_ALLOWED_ORIGIN:-http://127.0.0.1:5173,http://localhost:5173}
# 仅在隔离的本地联调需要访问 localhost/局域网明文测试服务时显式改为 true。
DASHBOARD_INTEGRATION_ALLOW_LOCAL_DEVELOPMENT_TARGETS=${DASHBOARD_INTEGRATION_ALLOW_LOCAL_DEVELOPMENT_TARGETS:-false}
# 专网明文/隔离测试开关。正式公网 HTTP 在来源选择 PUBLIC_HTTP 并填写主机、端口白名单，无需开启。
DASHBOARD_INTEGRATION_ALLOW_PLAIN_HTTP=${DASHBOARD_INTEGRATION_ALLOW_PLAIN_HTTP:-false}
DASHBOARD_INTEGRATION_RECOVERY_INTERVAL_SECONDS=${DASHBOARD_INTEGRATION_RECOVERY_INTERVAL_SECONDS:-30}
# 保留期清理默认每5分钟开始一轮；每次维护最多20个接入方、每类100条，未扫描完时继续轮转。
DASHBOARD_INTEGRATION_RETENTION_CLEANUP_INTERVAL_SECONDS=${DASHBOARD_INTEGRATION_RETENTION_CLEANUP_INTERVAL_SECONDS:-300}

REDIS_HOST=${REDIS_HOST:-127.0.0.1}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_DATABASE=${REDIS_DATABASE:-0}

BACKEND_PORT=${BACKEND_PORT:-8080}
# 局域网访问时设为 0.0.0.0；默认仅允许本机访问。
FRONTEND_HOST=${FRONTEND_HOST:-127.0.0.1}
FRONTEND_PORT=${FRONTEND_PORT:-5173}

# 接入外部凭证：credentialRef 可使用 ENV:变量名 或 FILE:文件名。
# 挂载文件由部署侧密钥服务原子更新，应用每次请求重新读取；不同来源/环境使用不同引用。
DASHBOARD_INTEGRATION_CREDENTIAL_ENV_ALLOWLIST=
DASHBOARD_INTEGRATION_CREDENTIALS_DIRECTORY=
DASHBOARD_INTEGRATION_AUDIT_RETENTION_DAYS=30
# 可选 ClamAV 扫描服务；PDF 或 scanRequired=true 的媒体未配置扫描器时拒绝访问。
DASHBOARD_INTEGRATION_SCANNER_HOST=
DASHBOARD_INTEGRATION_SCANNER_PORT=3310
DASHBOARD_INTEGRATION_SCANNER_TIMEOUT_SECONDS=10
